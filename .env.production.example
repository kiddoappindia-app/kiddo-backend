# ==============================================================================
# KidDo Production Environment Variables Template
# ==============================================================================
# IMPORTANT: Never commit actual production secrets to git. This template
# serves as the configuration schema for production hosting (e.g., Render, VPS).
# 
# Key Rotation Schedule Recommendation:
# - JWT secrets: every 6 months.
# - MongoDB credentials: once a year, or immediately upon developer offboarding.
# - Firebase Private Keys: once a year.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port
PORT=4000

# MongoDB Production Atlas URI
# Ensure network whitelist limits access ONLY to production server IPs.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your-production-mongodb-connection-string

# JWT Secret Keys
# Must be generated using high entropy cryptographically secure random generators.
# Recommended command: openssl rand -base64 64
JWT_ACCESS_SECRET=your-secure-production-jwt-access-secret-minimum-64-chars
JWT_REFRESH_SECRET=your-secure-production-jwt-refresh-secret-minimum-64-chars

# JWT Session Expiry Duration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Web Origins (comma-separated list for CORS validation)
# Do not include wildcards (*) in production unless absolutely necessary.
# Example: https://kiddoapp.in,https://www.kiddoapp.in
CLIENT_ORIGIN=https://kiddoapp.in,https://www.kiddoapp.in

# Firebase Admin SDK Service Account JSON
# Paste the single-line JSON string without line breaks.
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
