NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/family-rewards

# JWT secrets — use strong random strings (min 16 chars)
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed CORS origins (comma-separated)
# For production, include your webapp domain(s)
CLIENT_ORIGIN=http://localhost:5173,https://kiddoapp.in,https://www.kiddoapp.in,https://dev.kiddoapp.in

# Firebase Admin SDK Service Account (JSON string, optional)
# Required for Firebase auth verification (Google sign-in)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
